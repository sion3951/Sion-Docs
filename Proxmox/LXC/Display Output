#Important
In proxmox webui you must go to "options" then "features" and enable "nesting" and "fuse" (fuse for appimage support)

#Setup Prerequisites
grep "^deb " /etc/apt/sources.list | sed s/deb/deb-src/ >> /etc/apt/sources.list
sudo apt install kde-plasma-desktop xorg dbus-x11 x11-xserver-utils lsb-release -y
#Add user called setup
sudo adduser setup
sudo usermod -aG sudo setup
#Change to user
su - setup

#Script to get xrdp working
wget https://www.c-nergy.be/downloads/xRDP/xrdp-installer-1.5.4.zip
unzip xrdp-installer-1.5.4.zip 
chmod +x xrdp-installer-1.5.4.sh
./xrdp-installer-1.5.4.sh
#Cleanup
rm xrdp-installer-1.5.4.sh
rm xrdp-installer-1.5.4.zip

